<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="slash.navigation.converter.gui.dialogs.ManagePositionListsDialog">
  <grid id="mp001" binding="contentPane" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="480" height="320"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="mp002">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="320" height="240"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="mp003" class="javax.swing.JList" binding="listPositionLists">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <grid id="mp004" layout-manager="GridLayoutManager" row-count="8" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="mp005" class="javax.swing.JButton" binding="buttonTop">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text resource-bundle="slash/navigation/converter/gui/RouteConverter" key="top-action"/>
            </properties>
          </component>
          <component id="mp006" class="javax.swing.JButton" binding="buttonUp">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text resource-bundle="slash/navigation/converter/gui/RouteConverter" key="up-action"/>
            </properties>
          </component>
          <component id="mp007" class="javax.swing.JButton" binding="buttonDown">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text resource-bundle="slash/navigation/converter/gui/RouteConverter" key="down-action"/>
            </properties>
          </component>
          <component id="mp008" class="javax.swing.JButton" binding="buttonBottom">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text resource-bundle="slash/navigation/converter/gui/RouteConverter" key="bottom-action"/>
            </properties>
          </component>
          <vspacer id="mp009">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
          <component id="mp015" class="javax.swing.JButton" binding="buttonNew">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text resource-bundle="slash/navigation/converter/gui/RouteConverter" key="new-positionlist-action"/>
            </properties>
          </component>
          <component id="mp010" class="javax.swing.JButton" binding="buttonRename">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text resource-bundle="slash/navigation/converter/gui/RouteConverter" key="rename-positionlist-action"/>
            </properties>
          </component>
          <component id="mp011" class="javax.swing.JButton" binding="buttonDelete">
            <constraints>
              <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text resource-bundle="slash/navigation/converter/gui/RouteConverter" key="delete-positionlist-action"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="mp012" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="2" left="0" bottom="1" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <hspacer id="mp013">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <component id="mp014" class="javax.swing.JButton" binding="buttonClose">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text resource-bundle="slash/navigation/converter/gui/RouteConverter" key="close"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
