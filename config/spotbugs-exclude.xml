<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs exclusions for the verify-phase gate (spotbugs:check).
     Every Match carries the reason it is excluded; prefer a targeted Match
     over widening a blanket one. -->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
    <!-- exposing internal representation is deliberate: RouteConverter is a
         single-process desktop app with no untrusted callers, and defensive
         copies in every getter/setter would buy nothing -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,EI_EXPOSE_STATIC_REP2,MS_EXPOSE_REP"/>
    </Match>

    <!-- JAXB classes generated by xjc into *.binding* packages; regenerated
         from the XSDs on every build, so they cannot be fixed at the source -->
    <Match>
        <Package name="~.*\.binding.*"/>
    </Match>

    <!-- JAXB ObjectFactory classes generated by xjc -->
    <Match>
        <Class name="~.*\.ObjectFactory"/>
    </Match>

    <!-- generated by the IntelliJ GUI Designer into every .form-backed class;
         regenerated on each form edit, so it cannot be fixed at the source -->
    <Match>
        <Method name="$$$getMessageFromBundle$$$"/>
    </Match>
    <!-- same threat model as above: a finalizer attack on a half-constructed
         object needs untrusted code subclassing ours inside the JVM -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- same threat model as above: these detectors guard against untrusted
         code in the JVM grabbing a publicly reachable monitor; every monitor
         here is only locked by RouteConverter's own code -->
    <Match>
        <Bug pattern="USO_UNSAFE_METHOD_SYNCHRONIZATION,USO_UNSAFE_STATIC_METHOD_SYNCHRONIZATION,USO_UNSAFE_OBJECT_SYNCHRONIZATION,USO_UNSAFE_ACCESSIBLE_OBJECT_SYNCHRONIZATION"/>
    </Match>

    <!-- RouteConverter never uses Java serialization; comparators and Swing
         components are Serializable only by inheritance -->
    <Match>
        <Bug pattern="SE_COMPARATOR_SHOULD_BE_SERIALIZABLE,SE_BAD_FIELD,SE_BAD_FIELD_STORE"/>
    </Match>

    <!-- System.exit is the contract of these entry points: command line exit
         codes, and refusing to start on a too old Java -->
    <Match>
        <Bug pattern="DM_EXIT"/>
        <Or>
            <Class name="slash.navigation.converter.cmdline.RouteConverterCmdLine"/>
            <Class name="slash.navigation.download.tools.MirrorCatalog"/>
            <And>
                <Class name="slash.navigation.converter.gui.BaseRouteConverter"/>
                <Method name="checkJavaPrequisites"/>
            </And>
        </Or>
    </Match>

    <!-- explicit collection is the point here: free memory before offering to
         restart with a larger heap after an OutOfMemoryError -->
    <Match>
        <Bug pattern="DM_GC"/>
        <Class name="slash.navigation.gui.helpers.WindowHelper"/>
        <Method name="handleOutOfMemoryError"/>
    </Match>

    <!-- well-known install locations probed for GPSBabel, and the default
         mirror directory of the maintainer-only catalog mirror tool -->
    <Match>
        <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
        <Or>
            <And>
                <Class name="slash.navigation.babel.BabelFormat"/>
                <Method name="findBabel"/>
            </And>
            <Class name="slash.navigation.download.tools.gui.CatalogMirrorFrame"/>
        </Or>
    </Match>

    <!-- the first line of a .poly file is the polygon name, which is skipped -->
    <Match>
        <Bug pattern="RV_DONT_JUST_NULL_CHECK_READLINE"/>
        <Class name="slash.navigation.graphhopper.PolyUtil"/>
        <Method name="parse"/>
    </Match>

    <!-- works around NullPointerExceptions deep inside Swing's BasicListUI on macOS -->
    <Match>
        <Bug pattern="DCN_NULLPOINTER_EXCEPTION"/>
        <Class name="slash.navigation.mapview.mapsforge.MapSelector"/>
        <Method name="zoomChanged"/>
    </Match>

    <!-- JFreeChart's ChartPanel constructor calls overridable methods before a
         subclass can set its fields, so the model is handed over statically -->
    <Match>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
        <Class name="slash.navigation.converter.gui.profileview.ProfileView"/>
        <Method name="initialize"/>
    </Match>

    <!-- equality is deliberately inherited: the added fields describe the
         photo file (camera, tagging state) or control change notification,
         and do not change which position or series an object is -->
    <Match>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
        <Or>
            <Class name="slash.navigation.photo.PhotoPosition"/>
            <Class name="slash.navigation.converter.gui.models.PatchedXYSeries"/>
        </Or>
    </Match>
</FindBugsFilter>
