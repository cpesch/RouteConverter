<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP dependency-check suppressions (issue #212).

  Wired via <suppressionFile> in the root pom.xml's dependency-check-maven
  configuration, so both the weekly .github/workflows/dependency-check.yml run
  (`dependency-check:aggregate -DfailBuildOnCVSS=7`) and a local
  `mvn dependency-check:aggregate -DfailBuildOnCVSS=7` apply the same suppressions
  (use :aggregate, not :check - :check at the root of this ~30-module reactor
  scans each module's own dependency subset rather than the single cross-module
  scan :aggregate performs, so the two would not report the same finding count).

  This file starts empty on purpose: don't add an entry to make a red run
  green. Every <suppress> below must carry, in its <notes>, a REASON the
  finding is a false positive or an accepted risk, and a RE-CHECK DATE by
  which someone re-evaluates whether the suppression still holds (a
  suppression with no expiry quietly hides a CVE forever). See
  https://jeremylong.github.io/DependencyCheck/general/suppression.html for
  the <suppress> element syntax (cve / vulnerabilityName / packageUrl /
  cpe / filePath matchers).

  Example (do not uncomment without a real reason and date):

  <suppress>
     <notes><![CDATA[
        REASON: false positive - CPE match to unrelated "foo" project, not
        our "foo-bar" dependency.
        RE-CHECK: 2027-01-01
     ]]></notes>
     <packageUrl regex="true">^pkg:maven/com\.example/foo-bar@.*$</packageUrl>
     <cve>CVE-0000-00000</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <suppress>
     <notes><![CDATA[
        REASON: false positive - CVE-2021-23408 is a prototype-pollution bug in
        the URL parser of GraphHopper's JavaScript web bundle
        (com.graphhopper:graphhopper-web-bundle before 3.2 / 4.0). The
        com.graphhopper.external group makes dependency-check assign this jar
        the CPE graphhopper:graphhopper and read the Jackson module's own
        version (2.x) as a GraphHopper version below 3.2. This jar is
        GraphHopper's fork of the Jackson JTS datatype module, not the web
        bundle, and our GraphHopper is graphhopper-core 11.0.
        RE-CHECK: 2027-04-01
     ]]></notes>
     <packageUrl regex="true">^pkg:maven/com\.graphhopper\.external/jackson-datatype-jts@.*$</packageUrl>
     <cve>CVE-2021-23408</cve>
  </suppress>
</suppressions>
