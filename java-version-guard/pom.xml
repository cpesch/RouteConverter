<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>java-version-guard</artifactId>
    <packaging>jar</packaging>
    <name>Java version guard for the jars that run on the user's Java</name>
    <parent>
        <groupId>slash.navigation</groupId>
        <artifactId>RouteConverter</artifactId>
        <version>3.8-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- The guard is the Main-Class of the Linux jars and must start on
                         any Java a user may still have, to tell that Java is too old
                         instead of dying with an UnsupportedClassVersionError. Its tests
                         run on the build JDK (JUnit 6 needs 17+). -options silences
                         javac's "release 8 is obsolete" note, which failOnWarning
                         would turn into an error. -->
                    <release>8</release>
                    <testRelease>${java.version}</testRelease>
                    <compilerArgs combine.children="append">
                        <arg>-Xlint:-options</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
